# Optional LLM-as-a-judge / LLM attack generation credentials (not required for default offline mode)
BREAKRAG_LLM_API_KEY=
BREAKRAG_LLM_BASE_URL=https://api.openai.com/v1
BREAKRAG_LLM_MODEL=gpt-4o-mini

# Optional HTTP RAG adapter credentials
BREAKRAG_RAG_API_KEY=
BREAKRAG_RAG_USERNAME=
BREAKRAG_RAG_PASSWORD=

# Runtime environment overrides
BREAKRAG_ENV=development
BREAKRAG_LOG_LEVEL=INFO
BREAKRAG_RANDOM_SEED=42

